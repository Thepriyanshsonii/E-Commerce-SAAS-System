# ==============================================================================
# SSJewellery E-Commerce Backend - Production Environment Variables
# Copy this file to .env on the server and customize the values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 🔴 REQUIRED VARIABLES (Crucial for basic system initialization & security)
# ------------------------------------------------------------------------------

# Database Connection (Neon Postgres)
# Must include sslmode=require for Neon security
DATABASE_URI=postgresql://user:password@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require

# Encryption & JWT Authentication Secrets
# JWT_SECRET: Strong random string for token generation and signing
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
# ENCRYPTION_KEY: AES 256-bit key (base64-encoded 32 bytes) for encrypting PII at rest
ENCRYPTION_KEY=your_base64_encoded_32_byte_key_here

# Frontend Application URL & Cross-Origin Configuration
# Used for OAuth redirects and CORS policy protection
FRONTEND_URL=https://your-frontend-app.vercel.app
CORS_ORIGINS=https://your-frontend-app.vercel.app,http://localhost:5173

# Email / SMTP Configuration (Gmail App Password)
# Used for verification codes (OTP) and monthly business report delivery
MAIL_USERNAME=your-sender-email@gmail.com
MAIL_PASSWORD=your_16_character_gmail_app_password
EMAIL_ADDRESS=your-sender-email@gmail.com
EMAIL_APP_PASSWORD=your_16_character_gmail_app_password

# ------------------------------------------------------------------------------
# 🟡 OPTIONAL / PERFORMANCE / INTEGRATION VARIABLES
# ------------------------------------------------------------------------------

# Debug Flags & Server Environment
FLASK_ENV=production
SQLALCHEMY_ECHO=False
PORT=5000

# Docker Process Controls
# Set INIT_DB_ON_STARTUP=True on first run to generate tables, then set to False
INIT_DB_ON_STARTUP=False
START_SCHEDULER=True

# Neon DB Connection Pooling Overrides
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=300

# OTP Modes (production = hides OTP codes in HTTP response payloads)
OTP_MODE=production

# Cloudinary Assets Storage (Required if uploading product images)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Default Admin Credentials Override
ADMIN_ID=admin
ADMIN_PASSWORD=your_strong_admin_password_here

# Google OAuth Integration (Optional)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-api-domain.com/api/auth/google/callback

# Microsoft OAuth Integration (Optional)
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_REDIRECT_URI=https://your-api-domain.com/api/auth/microsoft/callback

# SMTP Mail Server Specifics (Defaults to Gmail SMTP relay)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
SMTP_FROM=SSJewellery <your-sender-email@gmail.com>
