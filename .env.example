# ====================================
# SSJewellery Backend - Environment Variables
# Copy this file to .env and fill in your values
# ====================================

# ── Database (Neon Postgres) ──
DATABASE_URI=postgresql://username:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# ── JWT Secret (CHANGE THIS!) ──
JWT_SECRET=your-super-secret-jwt-key-change-this

# ── Frontend URL (for CORS and OAuth redirects) ──
FRONTEND_URL=https://your-app.vercel.app
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# ── Cloudinary (Image uploads) ──
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Email / SMTP (Gmail App Password) ──
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
EMAIL_ADDRESS=your-email@gmail.com
EMAIL_APP_PASSWORD=your-gmail-app-password

# ── OTP Mode ──
OTP_MODE=production

# ── Google OAuth (optional) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-backend-ip-or-domain/api/auth/google/callback

# ── Microsoft OAuth (optional) ──
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://your-backend-ip-or-domain/api/auth/microsoft/callback

# ── Server ──
PORT=5000

# ── Encryption Key (for sensitive data at rest) ──
ENCRYPTION_KEY=

# ── Debug Flags ──
SQLALCHEMY_ECHO=False
