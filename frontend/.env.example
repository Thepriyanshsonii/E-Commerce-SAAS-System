# ============================================================
# E-Commerce Frontend - Environment Configuration Template
# ============================================================
# Copy this file to .env.local (local dev) or set these as
# Environment Variables in your Vercel project dashboard.
# NEVER commit .env.local to version control.
#
# Environments: development | qa | production
# ============================================================

# ----------------------------
# BACKEND API URL
# This is the only variable that changes per environment.
# ----------------------------
VITE_API_BASE_URL=http://localhost:5000/api

# ----------------------------
# APP ENVIRONMENT LABEL
# (Optional - useful for showing env banners in UI)
# ----------------------------
VITE_APP_ENV=development
